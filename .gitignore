# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# claude code local settings (personal, not team-shared)
.claude/settings.local.json

# prisma sqlite db (local only)
/prisma/dev.db
/prisma/dev.db-journal

# personal data — never commit real PII/self-ID/answers
/config/profile.local.json
/config/answers.local.json

# screenshots from auto-apply runs (may contain personal form data)
/public/screenshots/
/screenshots/

# structured per-run logs (may reference personal form data)
/logs/

# per-job tailored resume PDFs (generated at apply-time, not source content)
/public/resumes/tailored/

# local resume preview PNGs (debug artifacts from scripts/preview-resume.ts)
/resumes/preview/

# claude code isolated agent worktrees (ephemeral tooling state)
/.claude/worktrees/

