// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  careersUrl         String
  atsType            String   @default("greenhouse") // greenhouse | lever | ashby | workday | custom | unknown
  active             Boolean  @default(true)
  consecutiveFailures Int     @default(0)
  blocked            Boolean  @default(false)
  lastFailureReason  String?
  createdAt          DateTime @default(now())
  jobs               Job[]
}

model Job {
  id                String        @id @default(cuid())
  externalId        String
  companySlug       String
  company           Company       @relation(fields: [companySlug], references: [slug])
  title             String
  url               String
  location          String?
  description       String?
  salaryMin         Int?
  salaryMax         Int?
  sponsorshipSignal String?       // "mentions_sponsorship" | "no_sponsorship" | "unknown"
  source            String        @default("company_scrape") // "company_scrape" | "jobdatalake"
  postedAt          DateTime?
  scrapedAt         DateTime      @default(now())
  applications      Application[]

  @@unique([externalId, companySlug])
}

model ResumeVariant {
  id           String        @id @default(cuid())
  category     String        @unique // "software-engineer" | "backend-developer" | "ai-engineer"
  label        String
  pdfPath      String
  keywords     String        // JSON-encoded string[]
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id              String         @id @default(cuid())
  jobId           String
  job             Job            @relation(fields: [jobId], references: [id])
  resumeVariantId String?
  resumeVariant   ResumeVariant? @relation(fields: [resumeVariantId], references: [id])
  dedupeId        String         @unique
  status          String         // ready_for_review | submitted | skipped_no_match | failed
  screenshotPath  String?
  notes           String?
  appliedAt       DateTime       @default(now())
}

model Profile {
  id        String   @id @default("singleton")
  data      String   // JSON-encoded profile blob (loaded from config/profile.local.json at seed time)
  updatedAt DateTime @updatedAt
}
